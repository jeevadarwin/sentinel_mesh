# .env.example — Sentinel Mesh backend environment variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your real .env file — it contains secrets.
# The .gitignore already excludes .env.

# ─────────────────────────────────────────────────────────────────────────────
# NIM (NVIDIA Inference Microservices) — Primary LLM provider
# ─────────────────────────────────────────────────────────────────────────────

# Your NVIDIA NIM API key from https://build.nvidia.com
NIM_API_KEY=nvapi-your-key-here

# The OpenAI-compatible base URL for your NIM endpoint.
# Example: https://integrate.api.nvidia.com/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# The NIM model identifier to use.
# Example: meta/llama-3.1-70b-instruct
NIM_MODEL=meta/llama-3.1-70b-instruct

# ─────────────────────────────────────────────────────────────────────────────
# Ollama — Local fallback LLM provider
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of your local Ollama server. Default is localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model tag to use as fallback.
# Make sure you've run: ollama pull gemma4:latest
OLLAMA_MODEL=gemma4:latest

# ─────────────────────────────────────────────────────────────────────────────
# Enrichment — Placeholder (used in Phase 3)
# ─────────────────────────────────────────────────────────────────────────────

# API key for threat-intel enrichment provider (e.g. AbuseIPDB, VirusTotal).
# Leave empty for Phase 1 — this is validated but not used until Phase 3.
ENRICHMENT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# General
# ─────────────────────────────────────────────────────────────────────────────

# Deployment environment.  Use "dev" locally, "prod" in deployment.
ENVIRONMENT=dev
